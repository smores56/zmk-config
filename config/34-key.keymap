#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define MAIN 0
#define SYM 1
#define NAV 2
#define FN 3

// Keep these in sync with QMK's TAPPING_TERM and QUICK_TAP_TERM.
#define HT_TERM 200
#define HT_QUICK 150

// 34-key positions for the 8/12/10/4 transform: L/R blocks interleave
// (0-3 L, 4-7 R, 8-13 L, 14-19 R, 20-24 L, 25-29 R, 30-31 L, 32-33 R).
#define LEFT_HAND_POSITIONS 0 1 2 3 8 9 10 11 12 13 20 21 22 23 24 30 31
#define RIGHT_HAND_POSITIONS 4 5 6 7 14 15 16 17 18 19 25 26 27 28 29 32 33

// Layer-taps stay tap-preferred so NAV/SYM/FN remain usable with the same hand.
&lt {
    tapping-term-ms = <HT_TERM>;
    quick-tap-ms = <HT_QUICK>;
};

/ {
    behaviors {
        // Opposite-hand trigger positions stop same-hand rolls; release-trigger
        // lets same-hand mod-taps stack (e.g. Shift+Ctrl+V).
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HT_TERM>;
            quick-tap-ms = <HT_QUICK>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_HAND_POSITIONS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HT_TERM>;
            quick-tap-ms = <HT_QUICK>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_HAND_POSITIONS>;
            hold-trigger-on-release;
        };

        // T=GUI taps on a fast T->H roll in "th"/"the"; other mods stay balanced.
        t_gui: tap_gui {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_GUI";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <HT_TERM>;
            quick-tap-ms = <HT_QUICK>;
            bindings = <&kp>, <&kp>;
        };

        dot_excl: dot_excl {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_EXCL";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_pipe: comma_pipe {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_PIPE";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp PIPE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK_RELEASE";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <750>;
            quick-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <15>;
            key-positions = <10 11>;
            bindings = <&kp ESC>;
            layers = <0>;
        };

        combo_tab {
            timeout-ms = <15>;
            key-positions = <11 12>;
            bindings = <&kp TAB>;
            layers = <0>;
        };

        combo_q {
            timeout-ms = <20>;
            key-positions = <1 2>;
            bindings = <&kp Q>;
            layers = <0>;
        };

        combo_z {
            timeout-ms = <20>;
            key-positions = <0 1>;
            bindings = <&kp Z>;
            layers = <0>;
        };

        combo_backslash {
            timeout-ms = <20>;
            key-positions = <5 6>;
            bindings = <&kp BSLH>;
            layers = <0>;
        };

        combo_caps {
            timeout-ms = <20>;
            key-positions = <6 7>;
            bindings = <&kp CAPS>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAIN_layer {
            bindings = <
                              &lt FN F   &kp M       &kp P      &kp V            &kp SEMI    &dot_excl  &kp FSLH    &lt FN J
            &kp W &hml LSHFT R &hml LALT S &hml LCTRL N &t_gui LGUI T &kp G      &comma_pipe &hmr RGUI A &hmr RCTRL E &hmr RALT I  &hmr RSHFT H &kp SQT
                  &kp X       &kp C      &kp L       &lt SYM D  &kp B            &kp MINUS   &lt SYM U  &kp O       &kp Y       &kp K
                                                     &kp ENTER  &lt NAV SPC      &skq RSHFT  &kp BSPC
            >;
        };

        SYM_layer {
            bindings = <
                                &kp N1 &kp N2 &kp N3    &kp STAR       &kp TILDE &kp LBRC  &kp RBRC &kp HASH
            &kp CARET &kp DOT   &kp N4 &kp N5 &kp N6    &kp EQUAL      &kp LT    &kp LPAR  &kp RPAR &kp GT   &kp AMPS  &kp GRAVE
                      &kp COMMA &kp N7 &kp N8 &kp N9    &kp PLUS       &kp DLLR  &kp LBKT  &kp RBKT &kp AT   &kp PRCNT
                                              &kp COLON &kp N0         &trans    &trans
            >;
        };

        NAV_layer {
            bindings = <
                              &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_NEXT           &kp F10 &kp F7  &kp F8 &kp F9
            &kp C_PP &kp LEFT &kp DOWN     &kp UP       &kp RIGHT  &kp LC(TAB)          &kp F11 &kp F1  &kp F2 &kp F3 &kp C_BRI_DN &kp C_BRI_UP
                     &kp HOME &kp PG_DN    &kp PG_UP    &kp END    &kp LS(LC(TAB))      &kp F12 &kp F4  &kp F5 &kp F6 &kp PSCRN
                                                        &none      &none                &trans  &kp DEL
            >;
        };

        FN_layer {
            bindings = <
                        &none        &none        &sys_reset   &bootloader      &bootloader &sys_reset   &none        &none
            &none &none &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0 &bt BT_CLR       &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none &none
                  &none &none        &bt BT_SEL 4 &bt BT_SEL 3 &none            &none       &bt BT_SEL 3 &bt BT_SEL 4 &none        &none
                                                  &none        &none            &trans      &none
            >;
        };
    };
};
